{
  "expo": {
    "name": "Toeic Trainer",
    "slug": "toeic-trainer",
    "version": "1.2.0",
    "runtimeVersion": "1.2.0",
    "updates": {
      "enabled": true,
      "url": "https://toeic-trainer-api.koreacentral.cloudapp.azure.com/api/updates/manifest",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toeic-trainer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.toeic.trainer",
      "adaptiveIcon": {
        "backgroundColor": "#09152D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09152D",
          "dark": {
            "backgroundColor": "#09152D"
          }
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ứng dụng cần quyền Camera để chụp ảnh đồ vật và nhận dạng từ vựng tiếng Anh.",
          "photosPermission": "Ứng dụng cần quyền truy cập Ảnh để nhận dạng từ vựng tiếng Anh từ hình ảnh."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
